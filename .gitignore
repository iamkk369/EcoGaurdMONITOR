# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Test & coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Node (npm scripts) ────────────────────────────────────────────────────────
node_modules/

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
# ── Runtime PID lock files (simulator, uvicorn, historical generator) ────────
*.pid

# ── Ad-hoc root helper scripts (local dev only; reference machine-specific
#    Windows absolute paths and must never be published) ─────────────────────
_inspect.py
_pyc_dis.py
_pycdis.txt

# ── Local databases & runtime state files ───────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db3
