IBM_CLOUD_API_KEY=your_ibm_cloud_api_key
IBM_CLOUD_REGION=us-south
IBM_WATSON_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small
WATSONX_PROJECT_ID=your_watsonx_project_id_placeholder
DATABASE_URL=postgresql://ecoguard:ecoguard@localhost:5432/ecoguardai
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=ecoguard/sensors
REDIS_URL=redis://localhost:6379
SECRET_KEY=change_me_in_production
ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:8000
# Comma-separated API keys enforced when ENVIRONMENT=production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty for development (all requests pass through in dev mode).
VALID_API_KEYS=
ALERT_EMAIL_SMTP=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=alerts@ecoguardai.com
ALERT_EMAIL_PASSWORD=your_email_password
REGULATORY_WEBHOOK_URL=https://your-regulatory-endpoint.com/webhook
# LLM Provider Configuration
# Supported: watsonx, ollama, stub (stub = offline mock responses)
LLM_PROVIDER=ollama
# Ollama settings (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.1-dense
# pgAdmin credentials (override before exposing to any non-localhost network)
PGADMIN_EMAIL=admin@ecoguardai.com
PGADMIN_PASSWORD=change_me_for_local_dev